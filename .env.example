# BharatGov Access Environment Configuration

# Deployment Environment
ENVIRONMENT=production
LOG_LEVEL=INFO

# VM Hardware Configuration (Auto-tuned for 24 vCPU / 96 GB RAM)
CPU_WORKERS=16
MAX_CONCURRENT_BROWSERS=8
DOMAIN_CONCURRENCY=1
REQUESTS_PER_SECOND_PER_DOMAIN=1.0

# Database & Storage
POSTGRES_USER=bharatgov
POSTGRES_PASSWORD=bharatgov_secure_password_change_me
POSTGRES_DB=bharatgov_access
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://bharatgov:bharatgov_secure_password_change_me@postgres:5432/bharatgov_access

# Redis Cache & Task Queue
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# Local AI / Ollama
OLLAMA_BASE_URL=http://ollama:11434
AGENT_MODEL=qwen3:4b
AGENT_FALLBACK_MODEL=qwen3:8b

# S3 / MinIO Evidence Storage
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minio_secure_password_change_me
MINIO_ENDPOINT=minio:9000
MINIO_BUCKET=bharatgov-evidence
DATA_DIR=./data

# Safety Governor & Budgets
MAX_PAGES_PER_DOMAIN_PER_CYCLE=10
MAX_EXTRA_PAGES_PER_DOMAIN=5
MAX_AGENT_STEPS_PER_DOMAIN=20
MAX_AGENT_RUNTIME_SECONDS=300
CRAWL_TIMEOUT_SECONDS=30
MAX_RETRIES=2
COOLDOWN_ON_429_SECONDS=60
COOLDOWN_ON_5XX_SECONDS=30
USER_AGENT=BharatGovAccessObservatory/1.0 (+https://datahub.kgp/bharatgov-access; research-bot@bharatgov.in)
